---
/** 神社参拝（神遊び）の入口。
 *
 *  ★このページの役割（2026-07-29 福田整理）
 *    ・参加すると何が変わるのか、何をするのかの「概要」
 *    ・声は /voice/ へリンク（ここには置かない）
 *    ・参加の前に本を読んでもらう → /book/
 *    ・参加時の注意
 *
 *  🔴 分刻みの行程・めぐる神社の羅列は書きません。
 *     ①企画旅行に見える（旅行業法）②そのまま真似される、の2つが理由。
 *     詳細はお申し込み後のしおりへ → 03b_ツアーページ_テンプレ
 *  🔴 **開催日程はサイトに載せません**（福田判断 2026-08-07）。
 *     ・いつ何をやるかは全部LINEでお知らせします
 *     ・理由は運用です。日程をサイトに置くと、決まるたび・終わるたびに
 *       更新が発生します。更新されない日程が残っているサイトが、いちばん信用を落とします
 *     ・そのかわりサイトには「**1日プランの中身と金額**」だけを置きます。
 *       読む人が知りたいのは、日付より先に「何をする、いくら」だからです
 *     🔴 「これからの参拝」のカード一覧は復活させないこと。運用を増やさない、が決めごとです
 *
 *  🔴 `/kamiasobi/<slug>/` が生成されるのは **state: 終了 の回だけ**（＝過去の記録）です
 *     → pages/kamiasobi/[...slug].astro の getStaticPaths
 *  🔴 参加費を出しているのは**このページだけ**になりました。
 *     下の「1日プラン」の表を消さないこと（/commerce-law/ の「販売価格は各サービスページに表示」が成り立たなくなります） */
import Base from '../../layouts/Base.astro';
import NoticeBox from '../../components/NoticeBox.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import PlaceGrid from '../../components/PlaceGrid.astro';
import LineCta from '../../components/LineCta.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/base';
import { themes } from '../../data/tourThemes';
import { LINE_URL } from '../../data/line';

/** 🔴 使うのは**終了した回だけ**です（2026-08-07〜）。
 *     これからの回は、下の「願いによって〜」の記録リンクにも日程にも出しません。
 *     tours コレクションは「過去の記録の置き場」になりました。 */
const past = (await getCollection('tours', ({ data }) => import.meta.env.DEV || !data.draft))
  .filter((t) => t.data.state === '終了')
  .sort((a, b) => +b.data.date - +a.data.date);

/** ★ここが過去の記録の入口です（福田判断 2026-07-31）。
 *  以前はページ末尾に「その日のこと」という日付順の一覧を置いていましたが、やめました。
 *  読み手は日付ではなく**願い**で探すためです。
 *
 *  🔴 データは src/data/tourThemes.ts が正本です（2026-08-04 に切り出し）。
 *     トップページでも同じものを使うので、**このファイルでは書き換えないこと**。 */

/** 🔴 リンク切れよけ。記録ページが無い（または draft の）回には
 *     リンクを出しません。themes に書いたIDを消し忘れても壊れません。 */
const pastIds = new Set(past.map((t) => t.id));

/** これまでに訪れた社。すべて**参拝プログラムで実際に行った社**です
 *  （福田さん確認 2026-07-30）。写真は岡さんの撮影分。
 *
 *  🔴 12枚（3×4）で打ち止めにしています。これ以上増やすと「写真集」になって、
 *     一枚ずつ見てもらえなくなります。追加分は各回の記録ページへ回すこと。
 *  🔴 並びは地理ではなく、願い別の3テーマ（下の themes）と対応させています。
 *     恋愛＝日光（瀧尾）／仕事・決断＝香取・鹿島／金運＝山梨（新屋山）。
 *     テーマを増やすときは、その土地の社をここにも足してください。
 *  🔴 社名が確かなものだけ。「たぶんここ」で書かないこと。
 *  🔴 顔が写り込んでいた写真は、書き出しの時点で切って人物を外しています
 *     → _tools/export_selected.py（Obsidian側）
 *  ⚠️ 集合写真は1枚も使っていません。参加者の掲載同意が未取得のため。 */
/** 🔴 2026-07-31：並び順を変えました。**日帰りで行ける社を先**に、遠方を後ろに。
 *
 *  ★理由。サイトで募集するのは日帰りのみに決めたのに、
 *    ここに伊勢や奈良が「行きます」として並んでいると矛盾します。
 *    見出しも「こういう場所へ行きます」→「これまでにめぐってきた社」に変えて、
 *    **これからの行き先ではなく実績**だと分かるようにしました。
 *  ⚠️ 遠方の5社（伊勢・伊雑宮・椿大神社・三輪・戸隠）は日帰り圏外です。
 *     消していないのは、実績の広がりが信頼になるのと、
 *     「あれはいつ行くの？」がLINEへの動機になるためです。
 *     並べ替えるときは、この境目を崩さないでください。 */
const places = [
  // ── 日帰りで行ける社 ──
  { src: '/assets/shrine/p-samukawa.jpg',   name: '寒川神社',   area: '神奈川', note: '日が落ちてからの神門。灯りだけが残ります' },
  { src: '/assets/shrine/p-kashima.jpg',    name: '鹿島神宮',   area: '茨城',   note: '始まりの神。区切りをつけたいときに' },
  { src: '/assets/shrine/p-katori.jpg',     name: '香取神宮',   area: '千葉',   note: '朱の楼門。鹿島と対で参ります' },
  { src: '/assets/shrine/p-sunosaki.jpg',   name: '洲崎神社',   area: '千葉',   note: '海に向かって立つ、富士見鳥居' },
  { src: '/assets/shrine/p-takinoo.jpg',    name: '瀧尾神社',   area: '栃木',   note: '日光。杉と紅葉のなかの石鳥居' },
  { src: '/assets/shrine/p-arayayama.jpg',  name: '新屋山神社', area: '山梨',   note: '富士の北麓。金運の社として知られます' },
  { src: '/assets/shrine/p-mitsumine.jpg',  name: '三峯神社',   area: '埼玉',   note: '狼が守る社。白い三ツ鳥居はここだけの形' },
  // ── ここから遠方（日帰り圏外）──
  { src: '/assets/shrine/p-ise.jpg',        name: '伊勢神宮',   area: '三重',   note: '宇治橋の大鳥居。ここから内宮へ入ります', focus: 'center 60%' },
  { src: '/assets/shrine/p-izawa.jpg',      name: '伊雑宮',     area: '三重',   note: '木の鳥居と玉砂利だけの、静かな別宮' },
  { src: '/assets/shrine/p-tsubaki.jpg',    name: '椿大神社',   area: '三重',   note: '杉木立のなかに、朱の鳥居' },
  { src: '/assets/shrine/p-miwa.jpg',       name: '三輪',       area: '奈良',   note: '山そのものが神さま。太い注連縄がかかります' },
  { src: '/assets/shrine/p-togakushi.jpg',  name: '戸隠',       area: '長野',   note: '随神門。ここから奥社への杉並木が始まります' },
];
---

<Base
  title="神社参拝プログラム"
  description="観光でも修行でもありません。神社という場所を借りて、自分のエネルギーを整えに行く日帰りの一日。神道歴40年の岡慶行が案内する、定員6名の参拝プログラム。"
  surface="dark"
>
  {/* ── ① 冒頭 ──
      🔴 「神社参拝」だけだと「誰でも行けるよね」と思われて価値が伝わりません（福田指摘 2026-07-30）。
         そこに正面から答えるところから始めます。
         位置づけ＝神社参拝を通じて自分を整えるプログラム。参拝は目的ではなく手段。 */}
  {/* 🖼 ヒーローだけは PhotoBand を使わず直に書いています。
         ①最初の1枚なので lazy にしない（fetchpriority="high"）
         ②見出しを写真の裾に重ねる、このページ専用のレイアウトだから
      文字は「写真の上」ではなく「地の色まで溶けきったところ」に置いています。
      写真の上に白文字を載せると、明るい部分で読めなくなるため。

      ★なぜ夜の写真なのか（2026-07-30 差し替え）
        サイト全体が深紫（#241C2E）です。昼の緑の写真だと、
        写真が終わって地の色が始まる線がはっきり出てしまいます。
        夜の参道なら**写真がそのまま地の色に続いて見える**。
        灯籠が奥へ収束していく構図も、これから入っていく感じに合います。 */}
  <section class="hero">
    <figure class="hero__f kenburns">
      <img
        src={withBase('/assets/shrine/hero-samukawa-night.jpg')}
        alt="日が落ちたあとの寒川神社の参道。灯籠の灯りが奥までまっすぐ続いている"
        width="1500"
        height="1129"
        fetchpriority="high"
      />
      <span class="hero__fade" aria-hidden="true"></span>
    </figure>

    <div class="wrap stack hero__txt" data-reveal>
      <p class="kicker">神社参拝プログラム</p>
      <h1>神社は、<br />誰でも行けます</h1>
      <p class="lede">
        でも、行っただけでは変わりません。<br />
        何を感じ、どう整えるか。<br />
        そこを案内する人がいるかどうかで、<strong>同じ一日の意味が変わります</strong>。
      </p>
      <p class="lede">
        神社という場を借りて、自分を整えるためのプログラムです。<br />
        岡はこれを「神遊び（かみあそび）」と呼んでいます。
      </p>
    </div>
  </section>

  {/* ── ② ひとりで行くのと何が違うのか ＝ 価値の核 ── */}
  <section class="section--tight">
    <div class="wrap stack" data-reveal>
      <p class="kicker">ひとりで行くのと、何が違うか</p>
      <h2>自分では組めない一日です</h2>

      <ul class="diff">
        <li>
          <span class="diff__t mj">どの神社へ行くか</span>
          <span class="note">
            その時期と、その日集まった方の状態に合う社を選びます。<br />
            観光地として有名かどうかでは選びません
          </span>
        </li>
        <li>
          <span class="diff__t mj">一日の組み立て</span>
          <span class="note">
            皇居で祈願してから出発し、めぐって、感謝を伝えて終わる。<br />
            この順番に意味があります
          </span>
        </li>
        <li>
          <span class="diff__t mj">道中の時間</span>
          <span class="note">
            車での移動が、この一日の半分です。<br />
            ここでの話がいちばん濃かった、とよく言われます
          </span>
        </li>
        <li>
          <span class="diff__t mj">感じたことを、その場で確かめられる</span>
          <span class="note">
            「いま何か感じた気がする」を、その場で聞ける。<br />
            あとで調べても、その感覚はもう戻ってきません
          </span>
        </li>
        <li>
          <span class="diff__t mj">定員6名</span>
          <span class="note">
            岡の車に同乗して回る人数です。<br />
            一日を通して、ひとりずつに向き合えます
          </span>
        </li>
      </ul>

      <p class="note">
        神道歴40年あまり。岡が「この人にはいま、これが必要だ」と見て、その日の話をします。
      </p>
    </div>
  </section>

  {/* ── ① 何が変わるのか ──
      🔴 効果の保証にならない書き方にすること（「〜と言われます」「〜が多いです」）。
         内容はアンケートの実際の回答に基づいています → /voice/ */}
  <section class="section--tight">
    <div class="wrap stack" data-reveal>
      <p class="kicker">参加された方に起きたこと</p>
      <h2>何が変わるのか</h2>
      <p class="note">アンケートに寄せられた声を、大きく4つに分けるとこうなりました。</p>

      <ul class="chg">
        <li>
          <span class="chg__t mj">気持ちが整った</span>
          <span class="note">小さなことに感謝の種を見つけられるようになった、という声がいちばん多いです</span>
        </li>
        <li>
          <span class="chg__t mj">日常が変わった</span>
          <span class="note">参拝の仕方が変わった。毎日の口ぐせが変わった</span>
        </li>
        <li>
          <span class="chg__t mj">仕事が動いた</span>
          <span class="note">申し込みが増えた、区切りがついた、という報告をいただきます</span>
        </li>
        <li>
          <span class="chg__t mj">身体で感じた</span>
          <span class="note">終わったあと身体が軽い。木に手をかざしたら温かかった</span>
        </li>
      </ul>

      <p><a href={withBase('/voice/')} class="btn btn--ghost">参加した方の声を読む</a></p>
      <p class="note">
        ※ 感じ方には個人差があります。特定の効果や結果をお約束するものではありません。
      </p>
    </div>
  </section>

  {/* 🔴 2026-08-07：ここにあった穴八幡宮の縦写真（plate-hikari.jpg）を外しました（福田判断）。
         このページの写真は全部**横位置の帯**で、額装の縦写真はここ1枚だけでした。
         前後の帯とリズムが合わず、唐突に見えます。
         ⚠️ 画像ファイルは public/assets/shrine/ に残してあります（styleguide でも使用中）。
            縦写真を使いたい回が出てきたら、**置き方から設計し直してから**戻すこと。
            1枚だけ違う形を混ぜない、が今の決めごとです。 */}

  {/* 🖼 一日の流れに入る直前に、その始まりの場所を見せます。
         「永田町集合」がただの待ち合わせではないことが、写真1枚で伝わります。 */}
  <PhotoBand
    src="/assets/shrine/band-kokyo.jpg"
    alt="朝の光が差す皇居のほりばた。木立のあいだから日が昇っている"
    caption="早朝の皇居。どの回も、ここから始まります"
    focus="center 55%"
  />

  {/* ── ② 何をするのか（概要まで） ── */}
  <section class="section--tight">
    <div class="wrap stack" data-reveal>
      <p class="kicker">一日のこと</p>
      <h2>何をするのか</h2>
      <div class="tablewrap">
        <table>
          <tbody>
            {/* 🔴 永田町なのは「皇居で旅の祈願をしてから出発する」ため。
                   どの回も同じ。ただの集合場所ではなく一日の始まりの儀式です（福田確認 2026-07-30） */}
            <tr><th>集合</th><td>永田町駅。朝、都内で集まります</td></tr>
            <tr>
              <th>はじめに</th>
              <td>皇居へ。この一日の祈願をしてから出発します。<br />
                  <strong>どの回も、ここから始まります</strong></td>
            </tr>
            <tr>
              <th>行きの道中</th>
              {/* 🔴 「神様と通じている岡さんが必要なことを伝える」をぼかした表現。
                     事実（回ごとに話が変わる）だけを言い、霊能寄りの説明はしない */}
              <td>車のなかで、その日の考え方をひととおり。<br />
                  その回の顔ぶれによって、話すことが変わります</td>
            </tr>
            <tr>
              <th>参拝</th>
              {/* 🔴 作法の指導が主ではありません。本の内容と揃えること（福田指摘 2026-07-30） */}
              <td>作法をなぞるのではなく、その場を感じることから。<br />
                  神域に入って、自分を整えていきます</td>
            </tr>
            <tr><th>次の社へ</th><td>岡の車に同乗して。感じたことを話しながら移動します</td></tr>
            <tr><th>昼食</th><td>途中でご一緒します。お支払いは各自でお願いしています</td></tr>
            <tr><th>おわりに</th><td>皇居へもどって、感謝を伝えます</td></tr>
            <tr><th>解散</th><td>永田町駅で解散します</td></tr>
          </tbody>
        </table>
      </div>
      <p class="note">
        めぐる神社とその日のテーマは、回ごとに変わります。<br />
        くわしい時刻と道のりは、お申し込みのあとにしおりでお送りします。
      </p>
      {/* 🔴 2026-08-07：ここにあった「日帰り・定員6名・実費」の4行を、下の「1日プラン」の表に移しました。
             同じことを2か所に書くと、片方を直したときにもう片方がずれます。
             ⚠️ 実費は「定額」ではなく「当日の実額を割る」と書くこと。
                定額にすると実費なのか対価なのか区別がつかなくなります → TRAVEL_LAW_MEMO 4d章
             ⚠️ 宿泊のことはこのサイトに書きません（日帰りのみ募集）→ TRAVEL_LAW_MEMO 第5章 */}
    </div>
  </section>

  {/* ── ③ 願わない ──
      🔴 「差し出す」はある神社での個別のエピソードで、全体に共通する話ではありません
         （福田指摘 2026-07-30）。ここでは使わないこと。
      🔴 軸は「感じる」と「整える」。作法の指導が主ではありません（本の内容と揃える） */}

  {/* 🖼 このページで一番の1枚。ページの真ん中で、いちばん長く見せます。
         「願う」ではなく「感じる」の話に入るので、社殿ではなく磐座にしました。
         建物より、苔と岩と木のほうが「空気の温度」の話に合うためです。
      ⚠️ 場所が判読できていないので、キャプションに社名を書いていません。 */}
  <PhotoBand
    src="/assets/shrine/band-iwakura.jpg"
    alt="苔むした林のなかに立つ大きな磐座。注連縄がかけられている"
    caption="注連縄のかかった磐座。木と苔と、岩だけの場所"
    size="tall"
    focus="center 50%"
  />

  <section class="section--tight">
    <div class="wrap stack" data-reveal>
      <h2>願わずに、感じる</h2>
      <p>
        多くの人が、神社でお願いごとをします。<br />
        でも「欲しい」と願うのは、<br />
        「足りない」と宇宙に宣言している状態です。
      </p>
      <p>
        だから、願うのをやめます。<br />
        代わりに、その場を<strong>感じる</strong>。
      </p>
      <p>
        空気の温度。木の気配。<br />
        自分の身体がどう反応しているか。<br />
        そこに気づけると、<strong>自然に整っていきます</strong>。
      </p>
      <p>
        作法を覚えることが目的ではありません。<br />
        そういう順番で、一日を過ごします。
      </p>
    </div>
  </section>

  {/* ── ④ 参加の前に、本を読んでほしい ── */}
  <section class="section--tight">
    <div class="wrap" data-reveal>
      <div class="book">
        <p class="kicker">参加の前に</p>
        <h2>本を一冊、読んできてください</h2>
        <p class="note">
          『願わず叶う神社参拝入門 ── 心の動きが運命を変える ──』<br />
          当日お話しすることの土台が、ここに書いてあります。
        </p>
        <p class="note">
          読んでから来られた方のほうが、<strong>その場で受け取れるものが深くなります</strong>。
          当日は、本に書いたことの先を実地でやっていきます。
        </p>
        <p><a href={withBase('/book/')} class="btn btn--ghost">本について見る</a></p>
      </div>
    </div>
  </section>

  {/* ── ⑤ 参加されるときのお願い ── */}
  <section class="section--tight">
    <div class="wrap stack" data-reveal>
      <p class="kicker">お願い</p>
      <h2>参加されるときに</h2>

      <NoticeBox title="持ちものと服装" tone="warn">
        <ul class="list-accent">
          <li>歩きやすい靴。屋外を1〜2時間ほど歩きます</li>
          <li>両手があくバッグ（リュックなど）</li>
          <li>雨具・防寒具。季節に合わせて</li>
          <li>参拝にふさわしい、清潔感のある服装</li>
        </ul>
      </NoticeBox>

      <NoticeBox title="神域でのこと" tone="info">
        <p>
