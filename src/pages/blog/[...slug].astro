---
import Base from '../../layouts/Base.astro';
import LineCta from '../../components/LineCta.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../utils/base';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => +b.data.pubDate - +a.data.pubDate);
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      newer: posts[i - 1],
      older: posts[i + 1],
      related: posts
        .filter((p) => p.id !== entry.id && p.data.category === entry.data.category)
        .slice(0, 3),
    },
  }));
}

const { entry, newer, older, related } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);

const dt = d.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const iso = d.pubDate.toISOString();

// 読了時間（日本語は400字/分の目安）
const chars = entry.body?.length ?? 0;
const minutes = Math.max(1, Math.round(chars / 400));

// 目次は h2 のみ。3つ以上あるときだけ出す
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={`${d.title}｜神道のはなし`} description={d.description} surface="dark" reading>
  <article class="post">
    {/* ── 記事ヘッダー：パンくず・タイトル・メタ ── */}
    <header class="post__hd section">
      <div class="wrap stack" data-reveal>
        <nav class="crumb tabnum" aria-label="パンくずリスト">
          <ol class="crumb-list">
            <li><a href={withBase('/')}>トップ</a></li>
            <li aria-hidden="true">／</li>
            <li><a href={withBase('/blog/')}>神道のはなし</a></li>
            <li aria-hidden="true">／</li>
            <li><a href={withBase(`/blog/?category=${encodeURIComponent(d.category)}`)}>{d.category}</a></li>
            <li aria-hidden="true">／</li>
            <li aria-current="page">{entry.data.title}</li>
          </ol>
        </nav>

        <p class="kicker">{d.category}</p>
        <h1>{d.title}</h1>

        <p class="meta tabnum">
          <time datetime={iso}>{dt}</time>
          <span aria-hidden="true">・</span>
          <span>約{minutes}分</span>
        </p>

        <p class="lede">{d.description}</p>
      </div>
    </header>

    {/* アイキャッチ画像（サムネイル画像） */}
    {d.heroImage && (
      <figure class="post__hero wrap" data-reveal>
        <img src={withBase(d.heroImage)} alt={d.title} width="1200" height="675" class="hero-img" />
      </figure>
    )}

    {toc.length >= 3 && (
      <nav class="toc-box wrap" aria-label="目次" data-reveal>
        <p class="toc-box__t">目次</p>
        <ol class="toc-box__l">
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}

    {/* ── 本文 ── */}
    <div class="wrap">
      <div class="body">
        <Content />
      </div>
    </div>

    {/* ── 署名。★2026-08-06 見直し ──
        🔴 名前は「**岡慶行**」（スペースなし）。about.astro の表記ルールに揃えました。
           スペース入りの「岡 慶行（おか よしゆき）」は**運営者情報と特商法だけ**です。
        🔴 肩書きを足しました。記事から流入した人は、そもそも書き手を知りません。
           「40年」という数字だけでは、何の40年か伝わっていませんでした。
        ⚠️ リンクは1本だけにします。読み終わりで行き先を並べると、どれも選ばれません。 */}
    <div class="wrap">
      <aside class="sign" data-reveal>
        <img src={withBase('/assets/oka-portrait.jpg')} alt="" width="120" height="120" loading="lazy" />
        <div class="sign__tx">
          <p class="sign__n mj">岡慶行</p>
          <p class="sign__r note">神道家 ／ ヒプノセラピスト ／ 造園家</p>
          <p class="note">
            十代の頃から、神道と造園の両方に師事してきました。<br />
            庭を見れば、その家の気の滞りが分かります。神社でやっていることも同じです。<br />
            場の巡りを読んで、整える。40年、それだけをやってきました。
          </p>
          <p class="note"><a href={withBase('/about/')}>岡慶行について →</a></p>
        </div>
      </aside>
    </div>

    {/* ── 記事末のLINE（全記事に固定挿入） ── */}
    <div class="wrap"><LineCta variant="inline" /></div>

    {/* ── 前後の記事 ── */}
    {(newer || older) && (
      <nav class="pager wrap" aria-label="前後の記事" data-reveal>
        {newer ? (
          <a href={withBase(`/blog/${newer.id}/`)} class="pager__i">
            <span class="pager__l">新しい記事</span>
            <span class="pager__t mj">{newer.data.title}</span>
          </a>
        ) : <span></span>}
        {older ? (
          <a href={withBase(`/blog/${older.id}/`)} class="pager__i pager__i--r">
            <span class="pager__l">古い記事</span>
            <span class="pager__t mj">{older.data.title}</span>
          </a>
        ) : <span></span>}
      </nav>
    )}

    {/* ── 関連記事 ── */}
    {related.length > 0 && (
      <section class="section">
        <div class="wrap stack" data-reveal>
          <p class="kicker">同じ分類のはなし</p>
          <ul class="list-accent">
            {related.map((p) => (
              <li><a href={withBase(`/blog/${p.id}/`)}>{p.data.title}</a></li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .post__hd { padding-block: 2.5rem 1.5rem; }

  /* パンくずリストスタイル */
  .crumb {
    font-size: var(--fs-note);
    color: var(--fg-2);
    margin-bottom: 1rem;
  }
  .crumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .crumb-list a {
    color: var(--fg-2);
    text-decoration: none;
  }
  .crumb-list a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .meta { font-size: var(--fs-note); color: var(--fg-2); display: flex; gap: .5rem; }

  .post__hero {
    margin-block: 1rem 2rem;
  }
  .hero-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    border: 1px solid var(--rule);
  }

  /* 目次：金の細線で挟む。本文の前に置く */
  .toc-box {
    margin-block: 2.5rem;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
  }
  .toc-box__t {
    font-size: var(--fs-label);
    letter-spacing: .18em;
    color: var(--accent);
    margin-bottom: .6rem;
  }
  .toc-box__l { margin: 0; padding-left: 1.3rem; }
  .toc-box__l li { font-size: var(--fs-note); line-height: 1.9; }
  .toc-box__l li::marker { color: var(--accent); }
  .toc-box__l a { border-bottom: 0; color: var(--fg); }
  .toc-box__l a:hover { color: var(--link); }

  /* ── 本文 ── */
  .body { padding-block: 1rem 2rem; }
  .body :global(p) { margin-block: 1.6rem; }
  .body :global(h2) {
    font-family: var(--mincho);
    font-weight: 400;
    font-size: var(--fs-h2);
    color: var(--accent);
    margin-block: 3.5rem 1.4rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 2rem;
    line-height: 1.6;
  }
  .body :global(h3) {
    font-family: var(--mincho);
    font-weight: 500;
    font-size: var(--fs-lg);
    color: var(--fg);
    margin-block: 2.5rem 1rem;
    scroll-margin-top: 2rem;
  }
  .body :global(ul) { margin-block: 1.6rem; }
  .body :global(li) { line-height: 2; margin-bottom: .4rem; }
  .body :global(li::marker) { color: var(--accent); }
  .body :global(strong) { color: var(--white); }
  .body :global(a) { color: var(--link); }
  .body :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin-block: 2.5rem;
  }

  /* 署名 */
  .sign {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .sign img { width: 84px; height: 84px; object-fit: cover; border-radius: 50%; flex-shrink: 0; }
  .sign__tx { display: flex; flex-direction: column; gap: .35rem; }
  .sign__n { font-size: var(--fs-body); color: var(--fg); }
  /* 肩書き。名前のすぐ下に置いて、本文より一段落とす */
  .sign__r { color: var(--accent); letter-spacing: .04em; }

  /* 前後の記事 */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .pager__i {
    display: flex;
    flex-direction: column;
    gap: .35rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--rule);
    transition: border-color .25s ease;
    text-decoration: none;
  }
  .pager__i:hover { border-color: var(--accent); }
  .pager__i--r { text-align: right; }
  .pager__l { font-size: var(--fs-label); letter-spacing: .12em; color: var(--accent); }
  .pager__t { font-size: var(--fs-sm); color: var(--fg); line-height: 1.6; }

  @media (max-width: 640px) {
    .pager { grid-template-columns: 1fr; }
    .pager__i--r { text-align: left; }
    .sign { flex-direction: column; gap: 1rem; }
  }
</style>
