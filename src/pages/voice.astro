---
import Base from '../layouts/Base.astro';
import LineCta from '../components/LineCta.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { withBase } from '../utils/base';
import { voiceCategories } from '../data/voices';

const demographics = [
  { label: '性別', value: '女性 約8割' },
  { label: '年代', value: '40代・50代が中心' },
  { label: 'お住まい', value: '首都圏が9割（東京・神奈川・埼玉・千葉）' },
  { label: 'ご職業', value: '会社員・自営業・カウンセラー・医師・主婦 など' },
];
---

<Base
  title="参加した方の声"
  description="神社参拝プログラム（神遊び）に参加された方から届いた声を掲載しています。アンケートに書いてくださったものをそのまま掲載しています。"
  surface="dark"
>
  <div class="wrap section stack">
    {/* ① 冒頭 */}
    <header class="stack" data-reveal>
      <p class="kicker">参加した方の声</p>
      <h1>参加した方から<br />届いた声です。</h1>
      <p class="lede">アンケートに書いてくださったものを、そのまま載せています。</p>
    </header>

    {/* 🖼 このページに置ける唯一の「人が写った写真」です。
           後ろ姿なので顔が分かりません。それでも「参拝している」は伝わります。
        🔴 集合写真は使いません。掲載同意が未取得であること、
           ぼかし加工は「隠している」印象になること、そして
           団体ツアーに見えて「定員6名でひとりずつ」というこの企画の
           いちばんの価値と食い違うためです。 */}
    <PhotoBand
      src="/assets/shrine/plate-sanpai.jpg"
      alt="拝殿の前にひとりで立ち、手を合わせている人の後ろ姿"
      caption="愛宕神社（東京）"
      plate
    />

    {/* ② 声（8件・4カテゴリ） */}
    {voiceCategories.map((cat) => (
      <section class="stack v-cat" data-reveal>
        <h2 class="v-cat__title">{cat.title}</h2>
        <div class="v-grid">
          {cat.items.map((item) => (
            <article class="v-card stack">
              {item.before && (
                <div class="v-card__sec">
                  <span class="v-card__label">参加前</span>
                  <p>{item.before}</p>
                </div>
              )}
              <div class="v-card__sec">
                <span class="v-card__label">印象に残ったこと</span>
                <p>{item.impression}</p>
              </div>
              <div class="v-card__sec">
                <span class="v-card__label">変化</span>
                <p>{item.after}</p>
              </div>
              {item.recommended && (
                <div class="v-card__sec">
                  <span class="v-card__label">すすめたい人</span>
                  <p>{item.recommended}</p>
                </div>
              )}
              <div class="v-card__author">
                <span>── {item.author}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  {/* 🖼 声を8件読んだあとに、一度言葉を切ります。
         🔴 全幅の帯は .wrap の中に置けないので、ここでいったん wrap を閉じています。
            この下でまた開き直しています。触るときは対応する </div> を見失わないこと。 */}
  <PhotoBand
    src="/assets/shrine/band-okumiya.jpg"
    alt="紫の幕がかかった拝殿。三つ巴の紋が並んでいる"
    caption="麻賀多神社 奥宮（千葉）"
    focus="center 45%"
  />

  <div class="wrap stack voice-lower">
    {/* ③ どんな人が来ているか */}
    <section class="stack demo-sec" data-reveal>
      <p class="kicker">どんな方が来ているか</p>
      <h2>どんな人が来ているか</h2>
      <div class="demo-grid">
        {demographics.map((d) => (
          <div class="demo-card">
            <span class="demo-card__label">{d.label}</span>
            <strong class="demo-card__val">{d.value}</strong>
          </div>
        ))}
      </div>
      <p class="note text-center">ひとりで参加される方がほとんどです。</p>
    </section>

    {/* ④ 締め */}
    <section class="stack text-center closing-sec" data-reveal>
      <h2>次は、あなたの番かもしれません。</h2>
      <div class="closing-btns">
        <a href={withBase('/kamiasobi/')} class="btn">神社参拝の日程を見る</a>
        <a href="#line" class="btn btn--ghost">LINEで受け取る</a>
      </div>
    </section>

    {/* LINE CTA */}
    <div id="line">
      <LineCta variant="section" />
    </div>
  </div>
</Base>

<style>
  /* 帯を挟むために wrap を分けた下半分。
     上の wrap が持っていた .section の余白をここで補っています */
  .voice-lower { padding-block: 1rem var(--gap-section); }

  .v-cat { margin-block: 1.5rem; }
  .v-cat__title {
    font-size: var(--fs-h2);
    color: var(--accent);
    letter-spacing: .04em;
    padding-bottom: .5rem;
    border-bottom: 1px solid var(--rule);
  }

  .v-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
  }

  .v-card {
    background: var(--bg-2);
    padding: 1.75rem;
    border-radius: 4px;
    border: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .v-card__sec { display: flex; flex-direction: column; gap: .35rem; }
  .v-card__label {
    font-size: var(--fs-note);
    color: var(--accent);
    font-weight: 500;
    letter-spacing: .05em;
  }
  .v-card__sec p { font-size: var(--fs-sm); line-height: 1.75; color: var(--fg); margin: 0; }

  .v-card__author {
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px dashed color-mix(in srgb, var(--accent) 25%, transparent);
    font-size: var(--fs-note);
    color: var(--fg-2);
    text-align: right;
  }

  .demo-sec { margin-block: 2rem; }
  .demo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
  }
  .demo-card {
    background: var(--bg-2);
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: .4rem;
  }
  .demo-card__label { font-size: var(--fs-note); color: var(--fg-2); }
  .demo-card__val { font-size: var(--fs-lg); color: var(--accent); font-weight: 500; }

  .closing-sec { padding-block: 2.5rem 1.5rem; }
  .closing-btns { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; }
  .text-center { text-align: center; }
</style>
