---
/** 石1点のページ。
 *
 *  構成の考え方（→ 20_Site/CONTENT_DRAFT/04b_石の詳細ページ設計.md）
 *    見る（写真・動画）→ 大きさを掴む → 岡の見立て → 事実 → 買い方
 *  ここは「ショップ」ではなく「ギャラリー」。見て楽しんで、気に入ったら買う場所です。
 *  だから購入ボタンは上に置かず、ひととおり見たあとに1つだけ置きます。
 *
 *  🔴 「岡の見立て」と「鉱物としての事実」を混ぜないこと。
 *     見立て＝岡さんの言葉。事実＝検証できることだけ。効能は書かない。 */
import Base from '../../layouts/Base.astro';
import LineCta from '../../components/LineCta.astro';
import Faq from '../../components/Faq.astro';
import NoticeBox from '../../components/NoticeBox.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../utils/base';

export async function getStaticPaths() {
  const all = (await getCollection('ishi')).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
  return all.map((entry, i) => ({
    params: { id: entry.data.id },
    props: { entry, prev: all[i - 1], next: all[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const b = d.basics;
const basicRows = (b
  ? [
      ['和名', b.jpName],
      ['鉱物', b.mineral],
      ['化学組成', b.formula],
      ['硬度', b.hardness],
      ['主な産地', b.origin],
      ['特徴', b.feature],
    ]
  : []
).filter(([, v]) => v) as [string, string][];

const specRows = ([
  ['サイズ', d.size],
  ['重さ', d.weight],
  ['素材', d.material],
] as [string, string | undefined][]).filter(([, v]) => v) as [string, string][];

const faq = [
  {
    q: `写真と同じ${d.kind}が届きますか。`,
    a: `はい。すべて一点ものです。掲載している写真${d.video ? '・動画' : ''}が、そのままお届けするものです。`,
  },
  d.kind === '石'
    ? {
        q: '天然石なので、傷や欠けはありますか。',
        a: '原石のままお渡ししているので、欠けや凹凸、内包物があります。\nそれも含めてその石です。気になる箇所があれば、お申し込み前にお問い合わせください。',
      }
    : {
        q: '天然のものなので、欠けや傷はありますか。',
        a: '自然のものをそのままお渡ししているので、欠けや傷、色むらがあります。\nそれも含めてその表情です。気になる箇所があれば、お申し込み前にお問い合わせください。',
      },
  {
    q: '贈りものにできますか。',
    a: 'できます。ご注文のときにお申し付けください。',
  },
];
---

<Base
  title={`${d.name}｜パワーストーン`}
  description={`${d.name}（一点もの・No.${d.id}）。${b?.jpName ? b.jpName + '。' : ''}岡慶行が選んだ、心を整えるためのパワーストーン。`}
  surface="dark"
>
  <article class="section">
    <div class="wrap stack">
      <nav class="crumb" aria-label="パンくずリスト">
        <ol class="crumb-list">
          <li><a href={withBase('/')}>トップ</a></li>
          <li aria-hidden="true">／</li>
          <li><a href={withBase('/mind/')}>心を整える</a></li>
          <li aria-hidden="true">／</li>
          <li aria-current="page">{d.name}</li>
        </ol>
      </nav>

      {/* ── ① まず見せる ── */}
      <figure class="main">
        <img src={withBase(d.photos[0])} alt={d.kind === '石' ? `${d.name}の原石` : d.name} width="1600" height="1200" />
      </figure>

      <div class="stack" style="gap:.35rem">
        <h1 class="mj">{d.name}</h1>
        {b?.jpName && <p class="note">{b.jpName}</p>}
        <p class="note tabnum">No.{d.id} ／ 一点もの</p>
        <p class="price tabnum">¥{d.price.toLocaleString('ja-JP')}<span class="note">（税込）</span></p>
      </div>

      {/* ── ②③ 動く光と、大きさ。★2026-08-06 ひとつの帯にまとめました ──
          🔴 素材の向きがバラバラなのが「ハマらない」原因でした。
             メイン写真＝横（4:3）／手に持った写真＝縦（3:4）／動画＝縦（9:16）。
             縦のものだけを**同じ高さの枠**に並べ、枠の側で比率を揃えています。
          ⚠️ 元ファイルは切っていません。CSSの object-fit で見せ方だけ揃えています。
             写真を差し替えても、この枠が吸収します。 */}
      {(d.video || d.photos.length > 1) && (
        <div class="stack" style="gap:.55rem">
          <div class="media">
            {d.video && (
              <figure class="media__i media__i--vid">
                {/* preload="none"：再生ボタンを押すまで通信ゼロ。ページを重くしない */}
                <video
                  src={withBase(d.video)}
                  poster={d.videoPoster ? withBase(d.videoPoster) : undefined}
                  controls
                  muted
                  loop
                  playsinline
                  preload="none"
                ></video>
              </figure>
            )}
            {d.photos.slice(1).map((p) => (
              <figure class="media__i">
                <img src={withBase(p)} alt={`${d.name}を手に持ったところ`} loading="lazy" />
              </figure>
            ))}
          </div>
          {d.video && d.videoNote && <p class="note media__cap">{d.videoNote}</p>}
        </div>
      )}

      {/* ── ④ 岡の見立て・この石のこと・使い方（本文） ── */}
      <div class="body"><Content /></div>

      {/* ── ⑤ 事実：この石そのもの ── */}
      {specRows.length > 0 && (
        <section class="stack" style="gap:.75rem">
          <h2 class="mj sec">このパワーストーンのかたち</h2>
          <div class="tablewrap">
            <table><tbody>{specRows.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table>
          </div>
        </section>
      )}

      {/* ── ⑥ 使い方と瞑想。★2026-08-06 新設 ──
          🔴 買う直前に「買ったあとも一人にしない」と分かることが目的です。
             動画の本体は /mind/ 側（src/data/mindVideos.ts）。ここは導線だけ置きます。 */}
      <section class="stack" style="gap:.75rem">
        <h2 class="mj sec">使い方と瞑想のしかた</h2>
        <p>
          持ち方、置き方、瞑想のはじめ方。<br />
          お求めいただいた方には、岡の解説動画をあわせてお届けしています。
        </p>
        <p class="note">
          瞑想は、うまくいく日といかない日があります。雑念が浮かぶ日もあります。それがふつうです。<br />
          <a href={withBase('/mind/#use')}>くわしくはこちら</a>
        </p>
      </section>

      {/* ── ⑦ 買い方 ── */}
      <section class="stack" style="gap:.75rem">
        <h2 class="mj sec">お届けについて</h2>
        <div class="tablewrap">
          <table>
            <tbody>
              <tr><th>価格</th><td class="tabnum">¥{d.price.toLocaleString('ja-JP')}（税込）</td></tr>
              <tr><th>送料</th><td>一律1,000円（1万円以上のお買い上げで無料）</td></tr>
              <tr><th>お届け</th><td>ご注文から7〜14日</td></tr>
              <tr><th>同梱</th><td>使い方を書いたカード</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <NoticeBox tone="law">
        <p>
          {d.kind === '石' ? '天然石の工芸品です。' : '天然素材でつくられたものです。'}
          <strong>医療的・霊的な効果を保証するものではありません。</strong>
        </p>
        <p>
          一点ものにつき、返品・交換はお受けできません（不良・破損の場合を除きます）。
          くわしくは<a href={withBase('/commerce-law/')}>特定商取引法に基づく表記</a>をご覧ください。
        </p>
      </NoticeBox>

      {d.soldout ? (
        <div class="stack">
          <p><span class="pill">SOLD OUT</span></p>
          <p>この石は売り切れました。</p>
          <p class="note">
            新しいものは、<a href={withBase('/line/')}>LINE公式</a>でいちばん先にお知らせしています。
          </p>
        </div>
      ) : (
        <div class="stack">
          {/* 🔴 2026-08-06：ボタンは**押した先で何が起きるか分かる言葉**にします。
                 Stripeの決済に飛ぶので「購入する」。「お迎えする」は、決済なのか問い合わせなのか読めません。
                 静かなトーンは、ボタンの周り（SOLD表示・本文）の言葉で保ちます。 */}
          <p><a href={d.stripeLink ?? withBase('/contact/')} class="btn">{d.kind === "石" ? "この石を購入する" : "購入する"}</a></p>
          <p class="note">
            {d.stripeLink
              ? 'カード決済に進みます。'
              : '※ 決済リンクは準備中です。お問い合わせからご連絡ください。'}
          </p>
        </div>
      )}

      <section class="stack" style="gap:.75rem">
        <h2 class="mj sec">よくあるご質問</h2>
        <Faq items={faq} />
      </section>

      {/* ── ⑨ 種類そのものの情報。★2026-08-06、中盤からここへ移してたたみました ──
          🔴 上のほうに置くと「タイガーアイ＝○○運」という既成のイメージで判断されます。
             それは岡さんの「石の名前や相場では選びません」と正面からぶつかります。
             ただ消しもしません。硬度や組成は、色を付けた石・樹脂で固めた石と違うことの
             **検証できる根拠**になるからです。だから「最後に、開きたい人だけ」の形にしています。
          ⚠️ 上へ戻さないこと。順番そのものが主張です。 */}
      {basicRows.length > 0 && (
        <details class="basics">
          <summary class="mj">{d.name}という{d.kind}について</summary>
          <div class="basics__b stack" style="gap:.75rem">
            <p class="note">
              種類で選ぶためのものではありません。<br />
              同じ{d.name}でも、一つひとつ違います。
            </p>
            <div class="tablewrap">
              <table><tbody>{basicRows.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table>
            </div>
            <p class="note">{d.kind === '石' ? '鉱物としての一般的な情報です。' : '一般的な情報です。'}効果・効能を示すものではありません。</p>
          </div>
        </details>
      )}

      <nav class="pager">
        {prev ? <a href={withBase(`/mind/${prev.data.id}/`)}>← {prev.data.name}</a> : <span></span>}
        {next ? <a href={withBase(`/mind/${next.data.id}/`)}>{next.data.name} →</a> : <span></span>}
      </nav>

      <p class="back"><a href={withBase('/mind/')}>一覧へもどる</a></p>
    </div>
  </article>

  <LineCta />
</Base>

<style>
  .crumb { font-size: var(--fs-note); color: var(--fg-2); }
  .crumb-list {
    display: flex; flex-wrap: wrap; align-items: center; gap: .4rem;
    list-style: none; padding: 0; margin: 0;
  }
  .crumb-list a { color: var(--fg-2); text-decoration: none; }
  .crumb-list a:hover { color: var(--accent); }

  /* メイン写真は正方形。石は中央に写っているので、左右が少し切れても成立します。
     🔴 元ファイル（1600×1200）はそのままです。切っているのは表示だけ。
     ⚠️ 石が切れて見えるようなら aspect-ratio を 4/3 に戻せば元どおりです。
        object-position で寄せ位置も変えられます（例：center 40%）。 */
  .main { background: #0d0b10; overflow: hidden; margin: 0; }
  .main img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* 種類そのものの情報（たたみ）。読みたい人だけが開く場所なので、静かに置く。
     ⚠️ 枠線や背景で目立たせないこと。目立てば「種類で選ぶ」ページに戻ります。 */
  .basics > summary {
    cursor: pointer;
    font-size: var(--fs-body);
    color: var(--fg-2);
    list-style: none;
    padding: .5rem 0;
  }
  .basics > summary::-webkit-details-marker { display: none; }
  .basics > summary::before { content: '＋ '; color: var(--accent); }
  .basics[open] > summary::before { content: '− '; }
  .basics > summary:hover { color: var(--accent); }
  .basics__b { margin-top: .5rem; }

  .price {
    font-family: var(--mincho);
    font-size: var(--fs-price);
    color: var(--fg);
    margin-top: .4rem;
  }
  .price .note { font-family: var(--gothic); margin-left: .3rem; }

  /* 動画：縦なので幅を抑えて中央に。横いっぱいにすると間延びする */
  /* 動画とサブ写真を、同じ高さ・同じ比率（3:4）の枠に並べる帯。
     列幅に上限（15rem）を付けているので、1点しかなくても間延びしません。
     🔴 動画の元データは 360×640 と小さいので、大きく引き伸ばすとぼやけます。
        枠を小さめに保つことが、そのまま画質の対策になっています。 */
  .media {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 15rem));
    justify-content: start;
    gap: .75rem;
  }
  .media__i {
    margin: 0;
    aspect-ratio: 3 / 4;
    background: #0d0b10;
    overflow: hidden;
    border-radius: 6px;
  }
  .media__i img,
  .media__i video { width: 100%; height: 100%; display: block; }
  /* 写真は枠いっぱいに（切る）。動画は縦長なので全体を見せる（切らない） */
  .media__i img { object-fit: cover; }
  .media__i--vid video { object-fit: contain; }
  .media__cap { margin: 0; }

  .sec {
    font-size: var(--fs-h2);
    color: var(--accent);
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
  }

  .body :global(h2) {
    font-family: var(--mincho);
    font-weight: 400;
    font-size: var(--fs-h2);
    color: var(--accent);
    margin-block: 2.5rem 1rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
  }
  .body :global(p) { margin-block: 1.2rem; line-height: 1.95; }
  .body :global(ul) { margin-block: 1.2rem; }
  .body :global(li) { line-height: 2; margin-bottom: .4rem; }
  .body :global(li::marker) { color: var(--accent); }
  .body :global(strong) { color: var(--white); }

  th { white-space: nowrap; width: 6.5rem; }

  .pager {
    display: flex; justify-content: space-between; gap: 1rem;
    padding-top: 2rem; border-top: 1px solid var(--rule);
    font-size: var(--fs-note);
  }
  .pager a { color: var(--accent); border-bottom: 0; }
  .back { font-size: var(--fs-note); }

  /* 🔴 スマホでも2列のままにします（.media の列上限が効くので、1列にすると逆に巨大になります）。
        以前の `.subs { grid-template-columns: 1fr; }` は、この作りでは不要になりました（2026-08-06）。 */
  @media (max-width: 640px) {
    .media { grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); }
  }
</style>
