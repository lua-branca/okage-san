---
/** トップページ。
 *
 *  ★構成（2026-08-04 更新。原稿 CONTENT_DRAFT/01_トップ.md v3 から変更）
 *
 *    ① FV（神社の写真）🔔 お知らせの帯 ② 案内する人 ③ 神社参拝とは ★主役
 *    ─ 写真の帯 ─ ④ 声 ⑤ これまでの参拝（願い別）⑥ 神道のはなし
 *    ⑦ ほかにもできること ⑧ LINE ★
 *
 *  🔴 2026-08-04 の変更（福田判断）
 *    ・⑤を「これからの参拝（日程一覧）」→「これまでの参拝（願い別）」に差し替え。
 *      オフィシャルな募集中の回が無い期間のほうが長く、毎回「調整しています」が
 *      出ていました。★募集していないときこそ**どんな一日なのか**を見せるほうが効きます。
 *    ・🔔お知らせの帯をFV直下に新設（src/data/news.ts）。セクションにはしません。
 *    ・「読み物」→「神道のはなし」。中身は全部 岡さん本人の語りなので、
 *      誰の何かが一発で伝わる名前にしました。**URLは /blog/ のまま**です
 *      （変えるとリダイレクト対応が要るため。表示文言だけの変更）。
 *    ・幅を3段階に（tokens.css）。それまで全セクションが656px1本で、
 *      PCで「細い1本の柱」に見えていました。ここは --mid と --wide を使っています。
 *
 *  🔴 いちばん大事な原則（触る前に読んでください）
 *     **主役は神社参拝。前半で厚く書き、ほかのサービスは⑧で薄く拾う。**
 *     一度「整え方は4つあります」という一覧を③に置きましたが、
 *     後半の個別ブロックと**同じことを2回言う形**になって失敗しました。
 *     一覧と個別ブロックを両方持つと必ず重複します。
 *
 *  🔴 そのほか、変えた理由
 *    ・FVが岡さんの顔写真で「人の紹介ページ」に見えていました → 神社の写真へ。
 *      岡さんは②で小さく紹介します。
 *    ・声は9件あるのに「（原稿から3件）」のままでした → 実装。
 *      ★③の直後に置くことで「神社参拝の声」だと文脈で分かります。
 *    ・記事にサムネイルが出ていませんでした（heroImage の渡し忘れ）。
 *    ・「整える会」は日程未定でボタンがLINEへ飛ぶだけ → 単独ブロックをやめました。
 *    ・締めの文章をやめました。岡さんへの導線は②にあり、二度言う必要がないためです。
 */
import Base from '../layouts/Base.astro';
import LineCta from '../components/LineCta.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import PostCard from '../components/PostCard.astro';
import VoiceCard from '../components/VoiceCard.astro';
import { getCollection } from 'astro:content';
import { topVoices } from '../data/voices';
import { news } from '../data/news';
import { themes } from '../data/tourThemes';
import { withBase } from '../utils/base';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 4);

/** ★お知らせは上から3件まで（src/data/news.ts が正本） */
const topNews = news.slice(0, 3);

/** ★終了した回。**願い別ブロックのリンク切れよけ**にだけ使います。
 *
 *  🔴 2026-08-04：ここは以前「これからの参拝（upcoming）」でした。やめた理由：
 *     募集は常にしているわけではなく、オフィシャルな募集中の回が無い期間のほうが長い。
 *     空欄や「調整しています」を毎回見せるより、
 *     **どんなツアーなのかを先に伝える**ほうがイメージが湧く（福田判断）。
 *     → 過去に行った回への導線に差し替えました。 */
const pastIds = new Set(
  (await getCollection('tours', ({ data }) => import.meta.env.DEV || !data.draft))
    .filter((t) => t.data.state === '終了')
    .map((t) => t.id)
);

/** ★トップの横スクロール写真帯。
 *  🔴 日帰りで行ける社を先に並べています。
 *     遠方（伊勢・三輪・戸隠）は入れていません。
 *     サイトで募集するのは日帰りのみなので、トップで遠方を推すと矛盾します
 *     → TRAVEL_LAW_MEMO 第4f章。もれなく見せるのは /kamiasobi/ の役目です。 */
const strip = [
  { src: '/assets/shrine/p-samukawa.jpg',   name: '寒川神社',   area: '神奈川' },
  { src: '/assets/shrine/p-kashima.jpg',    name: '鹿島神宮',   area: '茨城' },
  { src: '/assets/shrine/p-katori.jpg',     name: '香取神宮',   area: '千葉' },
  { src: '/assets/shrine/p-takinoo.jpg',    name: '瀧尾神社',   area: '栃木' },
  { src: '/assets/shrine/p-mitsumine.jpg',  name: '三峯神社',   area: '埼玉' },
  { src: '/assets/shrine/p-arayayama.jpg',  name: '新屋山神社', area: '山梨' },
  { src: '/assets/shrine/p-sunosaki.jpg',   name: '洲崎神社',   area: '千葉' },
  { src: '/assets/shrine/p-atago.jpg',      name: '愛宕神社',   area: '東京' },
  { src: '/assets/shrine/p-makata.jpg',     name: '麻賀多神社', area: '千葉' },
  { src: '/assets/shrine/p-anahachiman.jpg', name: '穴八幡',    area: '東京' },
];

/** ★神社参拝の「ひとりで行くのと何が違うか」。/kamiasobi/ の要約です。
 *  🔴 トップは要約、詳細は /kamiasobi/。増やさないこと（3つで止める）。 */
const points = [
  { t: 'どの神社へ行くか', d: 'その時期と、その日集まった方の状態に合う社を選びます。有名かどうかでは選びません' },
  { t: '道中の時間',       d: '車での移動が、この一日の半分です。ここでの話がいちばん濃かった、とよく言われます' },
  { t: '定員6名',         d: '岡の車に同乗して回る人数です。一日を通して、ひとりずつに向き合えます' },
];

/** ★「ほかにもできること」＝**神社を除いた3つ**。
 *
 *  🔴 2026-07-31：以前ここに「整え方は4つあります」という一覧を置いていましたが、
 *     後半の個別ブロック（自宅で整える・著書）と**同じことを2回言う形**になっていました。
 *     一覧と個別ブロックを両方持つと必ず重複します。
 *     → **主役（神社）はページ前半で厚く、それ以外はここで薄く**、に整理しました。
 *     ここに神社を足さないでください。重複が復活します。
 *
 *  🔴 著書はAmazonへ直リンクせず /book/ を経由します。
 *     サイトからの離脱を、いちばん最後に寄せるためです。 */
const others = [
  { t: '手元に置く',   d: '岡が選んだ一点もののパワーストーン。家でも整えるための道具です。', href: '/mind/',    label: '心を整える' },
  { t: '内側から解く', d: '前世療法・ヒプノセラピー。深いところに残っているものを解いていきます。',   href: '/session/', label: '個人セッション' },
  { t: '読んでみる',   d: '『願わず叶う神社参拝入門』。40年ぶんを1冊にしました。',                     href: '/book/',    label: '著書' },
];
---

<Base
  title="マインドフリー神道学アカデミア"
  description="神社は願いを叶える場所ではなく、自分を整える場所。神道歴40年あまりの岡慶行が案内する、日帰り・定員6名の神社参拝プログラムと、手元で整えるための道具。"
  surface="dark"
>
  {/* ① ファーストビュー
      🔴 2026-07-31：岡さんの顔写真をやめ、神社の写真に変えました。
         顔がドーンと出ていて「人の紹介ページ」に見えていたためです（福田指摘）。
         ★売っているのは岡さんではなく「整う一日」なので、まず場所を見せます。
         岡さんは②で小さく紹介します。
      文字は写真の上ではなく、地の色まで溶けきったところに置いています
      （明るい部分に白文字が乗ると読めないため）。/kamiasobi/ と同じ作りです。 */}
  {/* 🔴 写真は4枚をゆっくり切り替えます（1枚6秒・全24秒）。
         ★動きは**切り替えだけ**。ケンバーンズ（ゆっくり寄る）は付けていません。
           2つ重ねるとうるさくなり、岡さんの文章の静けさとぶつかります。
         ★色の系統をばらけさせています：夜（青）→ 紅葉（暖）→ 白い鳥居 → 夕暮れ。
           同系色を並べると、切り替わったことに気づきません。
         🔴 CSSアニメーションだけで動かしています。JSは使いません。
            JSが止まっても1枚目が出たままになるので、内容は必ず読めます。
            動きを減らす設定の人には1枚目で固定されます（下のCSS）。
         ⚠️ 1枚目だけ eager。残り3枚は lazy にして初回表示を軽くしています。 */}
  <section class="fv">
    <figure class="fv__f">
      {[
        { src: '/assets/shrine/fv-1-samukawa.jpg',  alt: '日が落ちたあとの寒川神社の参道。灯籠の灯りが奥までまっすぐ続いている' },
        { src: '/assets/shrine/fv-2-takinoo.jpg',   alt: '紅葉に囲まれた朱色の門と、その先へ続く石段' },
        { src: '/assets/shrine/fv-3-mitsumine.jpg', alt: '三峯神社の白い三ツ鳥居。左右に狼の像が立つ' },
        { src: '/assets/shrine/fv-4-kashima.jpg',   alt: '雪の残る夕暮れの鹿島神宮。楼門に灯りがともる' },
      ].map((s, i) => (
        <img
          class="fv__slide"
          src={withBase(s.src)}
          alt={i === 0 ? s.alt : ''}
          width="1400"
          height="1054"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'low'}
          aria-hidden={i === 0 ? undefined : 'true'}
        />
      ))}
      <span class="fv__fade" aria-hidden="true"></span>
    </figure>

    <div class="wrap stack fv__txt" data-reveal>
      <h1>
        神社は、願いを叶える場所じゃない。<br />
        自分を整える場所です。
      </h1>
      <p class="lede">
        観光でもなく、修行でもなく。<br />
        <strong>場を借りて、自分のエネルギーを整えに行く一日</strong>です。
      </p>
      <p class="fv__btns">
        <a href={withBase('/kamiasobi/')} class="btn">神社参拝について見る</a>
        <a href="#line" class="btn btn--ghost">LINEで受け取る</a>
      </p>
    </div>
  </section>

  {/* 🔔 お知らせ（細い帯）─ 2026-08-04 新設
      🔴 セクションにしないこと。厚く作ると主役の神社参拝が下に押し下げられます。
         更新が止まったときにいちばん目立つのもお知らせ欄なので、**薄く**置いています。
      🔴 中身は src/data/news.ts。0件のときは帯ごと消えます（空欄を出さない）。
      🔴 幅は .wrap（＝--col）。**FVの見出しと同じ幅・同じ左端**に揃えます（福田指摘 2026-08-04）。
         一度 --wide にしていましたが、見出しより外側から始まってしまい、
         ページの左の縦線が2本あるように見えていました。ここは広げないこと。 */}
  {topNews.length > 0 && (
    <aside class="news" aria-label="お知らせ">
      <div class="wrap">
        <ul class="news__l">
          {topNews.map((n) => (
            <li class="news__i">
              <time class="news__d">{n.date}</time>
              {n.href ? (
                <a href={n.href.startsWith('http') ? n.href : withBase(n.href)}>{n.text}</a>
              ) : (
                <span>{n.text}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )}

  {/* ② 何をする人か ＋ 岡さんの紹介（小さく）
      ★写真は横に小さく置きます。主役は言葉のほうです。 */}
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="who">
        <figure class="who__img">
          <img src={withBase('/assets/oka-portrait.jpg')} alt="岡 慶行" width="360" height="270" loading="lazy" />
        </figure>
        {/* 🔴 2026-07-31：肩書きの列挙をやめました。
               「植木屋40年／神道40年」だけだと経歴で、人柄が出ません。
               ★岡さんのFB932件から出てくる実像は「明るくて、出し惜しみしない人」です。
                 神様の話をしていても深刻になりません。そこが伝わる書き方に変えました。
               ⚠️ ここは要約です。根拠と詳細は /about/ の「こういう人です」に置いています。 */}
        <div class="stack">
          <p class="kicker">案内する人</p>
          <h2>庭を40年、<br />神社を40年。</h2>
          <p>
            土をさわる仕事と、神様と話す仕事。<br />
            まったく別だと言われますが、<strong>岡慶行にとっては同じことでした</strong>。
            どちらも、流れが止まっているところを見つけて、整える。
          </p>
          <p class="note">
            考えていることは、いつも全部書いてしまう人です。<br />
            神様の話をしていても、深刻になりません。
          </p>
          <p><a href={withBase('/about/')}>岡慶行という人について →</a></p>
        </div>
      </div>
    </div>
  </section>

  {/* ③ 神社参拝とは ─ ★メイン商品。ここだけ厚く書きます（2026-07-31）
      🔴 トップの主役は神社参拝です。ほかのサービスは⑧で薄く拾います。
         ここに石やセッションの話を混ぜないでください。主役がぼやけます。 */}
  <section class="section">
    <div class="wrap stack" data-reveal>
      <p class="kicker">神社参拝プログラム</p>
      <h2>神社は、誰でも行けます</h2>
      <p class="lede">
        でも、行っただけでは変わりません。<br />
        何を感じ、どう整えるか。<br />
        そこを案内する人がいるかどうかで、<strong>同じ一日の意味が変わります</strong>。
      </p>

      <ul class="pts">
        {points.map((p) => (
          <li class="pts__i">
            <span class="pts__t mj">{p.t}</span>
            <span class="note">{p.d}</span>
          </li>
        ))}
      </ul>

      <p class="note">
        <strong>日帰りです。</strong>朝に永田町を出て、その日のうちに永田町へ戻ります。
      </p>
      <p><a href={withBase('/kamiasobi/')} class="btn">神社参拝について見る</a></p>
    </div>
  </section>

  {/* 🖼 主役の説明のあとに、行き先を横に流して見せます（2026-07-31）。
         ★1枚の帯から横スクロールに変えました。
           「どこへ行くのか」は1枚では伝わらず、枚数と幅で伝わるためです。
         🔴 ここは自動で動かしません。ヒーローが切り替わっているので、
            2か所が同時に動くと画面が落ち着きません。 */}
  <PhotoStrip places={strip} note="これまでにめぐってきた社。指で横に送れます" />

  {/* ④ 参加した方の声 ─ 3件
      ★③のすぐ後ろに置いています。**神社参拝の声**だと文脈で分かるようにするためです
        （2026-07-31 福田指摘：サービス一覧の直後だと、どれの声か分からなくなっていた）。
      🔴 文面は src/data/voices.ts が正本。ここで書き換えないこと */}
  <section class="section">
    <div class="wrap wrap--mid stack">
      <div class="lead-col sec-head" data-reveal>
        <p class="kicker">参加した方の声</p>
        <h2>何が変わったのか</h2>
        <p class="note">アンケートに書いてくださったものを、そのまま載せています。</p>
      </div>
      <div class="voices" data-reveal-stagger>
        {topVoices.map((v) => <VoiceCard text={v.after} who={v.author} />)}
      </div>
      <p data-reveal><a href={withBase('/voice/')}>ほかの声を読む →</a></p>
    </div>
  </section>

  {/* ⑤ これまでの参拝 ─ 願い別に、過去の回の記録へ
      🔴 2026-08-04：ここは「これからの参拝（日程一覧）」でした。差し替えた理由：
         募集中の回が無い期間のほうが長いので、毎回「調整しています」が出ていました。
         ★募集していないときこそ、**どんな一日なのか**を見せるほうが効きます（福田判断）。
      🔴 データは src/data/tourThemes.ts が正本。/kamiasobi/ と共有しています。
         ここで書き換えないこと。
      ⚠️ 日程は出しません。日程を知りたい人は /kamiasobi/ と LINE に行きます。 */}
  <section class="section">
    <div class="wrap wrap--mid stack">
      <div class="lead-col sec-head" data-reveal>
        <p class="kicker">これまでの参拝</p>
        <h2>願いによって、<br />行き先が変わります</h2>
        <p class="lede">
          その時期と、その方の状態に合う神社を選んでご案内しています。<br />
          これまでにめぐった土地を、願いごとに分けるとこうなります。
        </p>
      </div>

      <ul class="th" data-reveal-stagger>
        {themes.map((t) => (
          <li class="th__i">
            <span class="th__n mj">{t.need}</span>
            <span class="th__a">{t.area}</span>
            <span class="note">{t.note}</span>
            {t.record && pastIds.has(t.record) && (
              <a href={withBase(`/kamiasobi/${t.record}/`)} class="th__r">
                {t.recordLabel ?? 'この回の記録を見る'} →
              </a>
            )}
          </li>
        ))}
      </ul>

      <p data-reveal><a href={withBase('/kamiasobi/')} class="btn">神社参拝について見る</a></p>
    </div>
  </section>

  {/* 🔴 2026-07-31：LINEブロックはページのいちばん最後へ移しました（福田判断）。
         ここ（日程の直後）にあると、記事とサービス紹介がLINEの後ろに埋もれます。
         ★LINEは「今日は申し込まない人」の受け皿なので、最後で正しい。
         FVの「LINEで受け取る」ボタンは #line へのアンカーなので、押せば最後まで飛びます。 */}

  {/* ⑥ 神道のはなし
      🔴 heroImage を渡すこと。渡さないとサムネイルが出ません
         （2026-07-31 まで渡し忘れていて、文字だけのリストになっていました）。
      ⚠️ PostCard は「200pxのサムネ＋本文」の横並びです。
         グリッドにすると潰れるので、1列のリストのまま使ってください。 */}
  <section class="section">
    <div class="wrap wrap--mid stack">
      <div class="lead-col sec-head" data-reveal>
        <p class="kicker">神道のはなし</p>
        <h2>書いてきたこと</h2>
      </div>
      <div class="posts" data-reveal-stagger>
        {posts.map((p) => (
          <PostCard
            slug={p.id}
            title={p.data.title}
            description={p.data.description}
            category={p.data.category}
            pubDate={p.data.pubDate}
            heroImage={p.data.heroImage}
            chars={p.body?.length ?? 0}
          />
        ))}
      </div>
      <p data-reveal><a href={withBase('/blog/')}>すべての記事を読む →</a></p>
    </div>
  </section>

  {/* ⑦ ほかにもできること ─ **神社を除いた3つ**（2026-07-31）
      🔴 ここに神社を足さないこと。③と重複します。
      ★締めの文章は置きません（岡さんへの導線は②にあり、二度言う必要がないため）。 */}
  <section class="section">
    <div class="wrap wrap--mid stack">
      <div class="lead-col sec-head" data-reveal>
        <p class="kicker">ほかにも</p>
        <h2>神社へ行くほかにも、<br />整え方があります</h2>
        <p class="lede">
          参拝の日に予定が合わなくても、できることはあります。
        </p>
      </div>

      <ul class="others" data-reveal-stagger>
        {others.map((o) => (
          <li class="others__i">
            <a href={withBase(o.href)} class="others__a">
              <span class="others__t mj">{o.t}</span>
              <span class="others__l">{o.label}</span>
              <span class="note">{o.d}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ⑧ LINE ★最重要CV。ページのいちばん最後 */}
