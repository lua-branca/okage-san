---
import Base from '../layouts/Base.astro';
import NoticeBox from '../components/NoticeBox.astro';
import Faq from '../components/Faq.astro';
import LineCta from '../components/LineCta.astro';
import { withBase } from '../utils/base';

/** 個別セッションの申し込み先。本番の申込フォーム（Xserver）へ直接飛ばします。
 *  🔴 ここは**本番フォーム**です。ローカルやプレビューから押すと、
 *     本物の申し込みとしてスプレッドシートに記録されます。テスト送信しないこと。
 *  tour_id / tour_name はフォームが hidden で受け取り、そのまま台帳に入ります。
 *  🔴 tour_id `session-hypno` と金額は `02_商品・サービスマスタ` が正本です。
 *     金額を変えるときは、スプシ・このURL・下の「44,000円」表示の3か所を必ず揃えること。 */
const SESSION_FORM_URL =
  'https://okage-san.com/form/?tour_id=session-hypno&tour_name=%E9%80%80%E8%A1%8C%E5%82%AC%E7%9C%A0%E3%82%BB%E3%83%83%E3%82%B7%E3%83%A7%E3%83%B3%2044,000%E5%86%86';

const faqs = [
  {
    q: '初めてでも催眠（トランス状態）に入れますか？',
    a: 'はい、大丈夫です。眠らされたり意識を失うわけではなく、リラックスして目を閉じ、心地よい深呼吸をしながら自分の内側に意識を向けていく状態です。意識は常にはっきりしており、途中で話すこともできます。',
  },
  {
    q: '前世が見えるか不安です。',
    a: '「見え方」には個人差があります。映像のように鮮明に見える方もいれば、感覚や感情、言葉、なんとなくのイメージとして受け取る方もいます。どのような受け取り方でも、必要なメッセージや気づきが得られるよう丁寧にガイドいたします。',
  },
  /* ⚠️ 2026-08-08 削除：「ヒプノセラピーとタントラはどちらを受ければいいですか？」
        レムリアン・タントラをこのページから外したので、比べる相手がいなくなりました。
        （答えは「事前カウンセリングで最適なアプローチをご提案します」でした。
         タントラを戻すときは、このQも一緒に戻すこと） */
  {
    q: '医療行為や治療ですか？',
    a: 'いいえ、医療行為や病気の治療を目的としたものではありません。ご自身の潜在意識にアクセスし、心を整え、内なる気づきを得るための個別ワークです。現在精神科等に通院・服薬中の方は事前にご相談ください。',
  },
];
---

<Base
  title="個別セッション（前世療法・ヒプノセラピー）"
  description="頭で考えても動かない悩みや、潜在意識の奥にある生きづらさへ。岡慶行による90分間の個別セッション（前世療法・ヒプノセラピー）。"
  surface="dark"
  reading
>
  <div class="wrap section stack">
    {/* ── ヒーロー ── */}
    <header class="session-hero stack" data-reveal>
      <p class="kicker">個人セッション</p>
      <h1 class="mj">
        頭で考えても、<br />
        どうしても動かないものへ。
      </h1>
      <p class="lede">
        神社へ行き、心を整えても、なお繰り返してしまう悩みや引っかかり。<br />
        それは今の自分より、もっと深い「潜在意識」の場所にあります。
      </p>
    </header>

    {/* ── 深いところへ降りる ── */}
    <section class="stack prose-section" data-reveal>
      <p class="kicker">考え方</p>
      <h2>なぜ、個別セッションを行うのか</h2>
      <div class="prose">
        <p>
          「なぜか同じような人間関係のトラブルを繰り返してしまう」<br />
          「頑張っているのに、どうしても理由のない不安やブレーキがかかる」
        </p>
        <p>
          日常の意識（顕在意識）だけで解決しようとしても、なかなか答えが出ないことがあります。<br />
          記憶の奥底、あるいは前世から引き継いできた魂のテーマや感情が、現在のあなたに影響を与えているからです。
        </p>
        <p>
          岡慶行の個別セッションでは、ヒプノセラピー（前世療法）を通して、静かに潜在意識の深層へと降りていきます。<br />
          あなた自身が内側にある「本当の理由」に気づき、心を解放するための90分間です。
        </p>
      </div>
    </section>

    {/* ── セッション内容 ──
        🔴 2026-08-08：ここは「2つのアプローチ」（ヒプノセラピー／レムリアン・タントラ）の
           2枚組カードでした。**レムリアン・タントラを取り下げて1本にしています**（福田判断）。
           選択肢が2つあると「どちらを選べばいいのか」が先に立ち、申し込みの手前で迷いが出ます。
           ★もともとページの中で数が合っていませんでした。
             アプローチは2つなのに、料金カードも申込フォーム（tour_id=session-hypno）も
             前世療法の1種類だけです。FAQに「どちらを受ければいいですか？」が
             必要になっていたのが、その歪みの表れでした（同日、そのQも削除）。
        ⚠️ **タントラの提供をやめたわけではありません。方針が決まったら戻します。**
           /about/ の提供サービス概要からも同日に外しました（サイト上はこれで0件）。
           そちらの直接の理由は「**90分の枠で提供しているものではない**のに
           前世療法と並べて『・90分』に入っていた」ことです（福田指摘）。
           🔴 戻すときは、所要時間と料金を確定させ、`02_商品・サービスマスタ`（正本）と
              料金カード・申込フォームを揃えること。ここだけ2種類に増やさない。 */}
    <section class="stack approach-section" data-reveal>
      <p class="kicker">進め方</p>
      <h2>ヒプノセラピー（前世療法）</h2>
      <div class="prose">
        <p>
          目を閉じ、深いリラックス状態（トランス状態）のなかで、潜在意識の記憶や前世のイメージをたどります。
        </p>
        <p>
          操られたり眠らされたりするのではありません。<br />
          あなた自身の感覚で、必要な記憶やメッセージを見つけに行きます。<br />
          岡はその傍らで、安全にガイドします。
        </p>
      </div>
    </section>

    {/* ── 料金・プラン（1種類に統一） ── */}
    <section class="stack plan-section text-center" data-reveal>
      <p class="kicker">料金</p>
      <h2>セッション料金</h2>

      <div class="plan-card stack">
        <span class="plan-tag">個別セッション（対面 / オンライン）</span>
        <h3 class="plan-title mj">前世療法・ヒプノセラピー</h3>
        <div class="plan-price">
          <span class="price-val">44,000</span>
          <span class="price-unit">円（税込）</span>
        </div>
        <p class="plan-time">所要時間：約 90 分（カウンセリング含む）</p>

        <div class="plan-details">
          <p>
            ※事前カウンセリング（セッション冒頭）を行ったうえで、その日のあなたの状態に合わせて進めます。<br />
            ※対面（神奈川県内サロン・静かな個室）またはオンライン（Zoom）にて承ります。
          </p>
        </div>

        <div class="plan-btn-wrap">
          <a href={SESSION_FORM_URL} class="btn btn--lg">
            このセッションを申し込む
          </a>
        </div>

        {/* ── 申し込みフォームの中身に合わせた案内。★2026-08-06 新設 ──
            🔴 フォームは**ツアーと共通**です。日程も、対面かオンラインかも聞いていません。
               だから「備考欄に書いてください」と、ここで先に伝える必要があります。
               これが無いと、日程調整のメールが必ず1往復増えます。
            🔴 フォームの項目を変えたら、この文面も直すこと（public/form/index.php）。 */}
        <div class="plan-flow stack">
          <p class="note">
            入力は2〜3分です（お名前・フリガナ・メールアドレス・電話番号・お住まいの都道府県）。<br />
            <strong>ご希望の日程と、対面かオンラインかは「備考」欄にご記入ください。</strong>
          </p>
          <p class="note">
            送信後、お支払いのご案内メールが自動で届きます（クレジットカード／銀行振込）。<br />
            日程は、そのメールのやりとりで確定します。
          </p>
          <p class="note">
            領収書が必要な方は、フォームの「領収書」で<strong>希望する</strong>を選び、
            宛名と但し書きを備考欄にご記入ください。
          </p>
        </div>
      </div>

      <p class="note plan-ask">
        いきなり申し込むのは、と迷われる方へ。
        <a href={withBase('/contact/')}>お問い合わせ</a>から、ご相談だけでも承ります。
      </p>
    </section>

    {/* ── 法務・注意事項 ── */}
    <section class="stack" data-reveal>
      <NoticeBox title="セッションに関する大切なお知らせ" tone="law">
        <p>
          本セッションは<strong>医療行為ではありません。</strong>
          病気の治療や特定の効果効能（願望成就・病状改善等）を保証するものではありません。
        </p>
        <p>
          <strong>性的なサービスは一切行いません。</strong>
          ワークはすべて衣服を着たまま、安全で静かな環境で行います。
        </p>
        <p>
          現在、精神科・神経科等に通院中の方、抗不安薬・睡眠薬等を服薬中の方は、事前にお知らせください。お体の状態によってはセッションをお受けできない場合がございます。
        </p>
      </NoticeBox>
    </section>

    {/* ── FAQ ── */}
    <section class="stack" data-reveal>
      <h2>よくあるご質問</h2>
      <Faq items={faqs} openFirst />
    </section>

    {/* LINE CTA */}
    <LineCta variant="section" />
  </div>
</Base>

<style>
  .session-hero h1 {
    font-size: var(--fs-hero);
    line-height: 1.35;
  }

  .prose-section {
    max-width: 48rem;
  }
  .prose p {
    font-size: var(--fs-lg);
    line-height: 1.85;
    color: var(--fg);
    margin-block: 1.25rem;
  }

  /* ⚠️ 2026-08-08：.approach-grid / .approach-card / .approach-card__badge を削除しました。
        「2つのアプローチ」の2枚組カードを1本の文章に変えて、使い手がいなくなったためです。
        カードに戻すなら git 履歴から拾えます。 */

  /* 料金カード */
  .plan-card {
    background: var(--bg-2);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 12px;
    padding: 2.5rem 2rem;
    max-width: 38rem;
    margin: 1.5rem auto 0 auto;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    align-items: center;
  }

  .plan-tag {
    font-size: var(--fs-note);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-weight: 600;
  }

  .plan-title {
    font-size: var(--fs-h2);
    color: var(--fg);
    margin: 0;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.4rem;
    color: var(--accent);
    margin-block: 0.5rem;
  }

  .price-val {
    font-size: 3rem;
    font-weight: 700;
    font-family: var(--mincho);
    line-height: 1;
  }

  .price-unit {
    font-size: var(--fs-xl);
    font-weight: 500;
  }

  .plan-time {
    font-size: var(--fs-lg);
    color: var(--fg);
    font-weight: 500;
    margin: 0;
  }

  .plan-details {
    font-size: var(--fs-note);
    color: var(--fg-2);
    line-height: 1.7;
    border-top: 1px dashed var(--rule);
    padding-top: 1.25rem;
    margin-top: 0.5rem;
  }

  .plan-btn-wrap {
    margin-top: 1rem;
  }

  /* 申し込みフォームの案内。
     🔴 カードの中は中央揃えですが、ここだけ**左揃え**にしています。
        3行以上の説明を中央揃えにすると、行頭が揃わず読みにくくなるためです。 */
  .plan-flow {
    margin-top: 1.4rem;
    text-align: left;
    max-width: 30rem;
    margin-inline: auto;
    gap: .7rem;
  }
  .plan-ask { margin-top: 1.1rem; }

  .btn--lg {
    padding: 1rem 2.5rem;
    font-size: var(--fs-lg);
  }

  .text-center {
    text-align: center;
  }
</style>
