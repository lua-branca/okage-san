---
import Base from '../layouts/Base.astro';
import { withBase } from '../utils/base';

const LINE_URL = 'https://lin.ee/XAxux9k';

/* 🔴 文言のルール（2026-08-06 見直し）
 *   ① **「週1回」「毎週」と書かない。**「不定期」に統一します。
 *      守れない約束になるためです（引き継ぎ書・LineCta.astro と同じルール）。
 *      直前まで、見出しは「不定期」なのにカードは「毎週配信」で、**同じページの中で矛盾**していました。
 *   ② **「無料」は1ページに1回だけ。** 押すほど売り込みの匂いが出ます。
 *   ③ **絵文字は使わない。**明朝と深紫の静かなトーンから浮きます（/about/ で外したのと同じ理由）。
 *   ④ **裏側の事情を読者に見せない。**「売るのはLINEです」「Facebookから厳選」等は書かない。 */
const benefits = [
  {
    tag: '登録特典 ①',
    title: '岡の声でご案内する、瞑想の導入動画',
    desc: '座り方、呼吸、意識の置きどころ。何も持たずに、今日から始められます。',
  },
  {
    tag: '登録特典 ②',
    title: '14日間のステップ講座',
    desc: '神社参拝の本当の意味と、日常で心を整えるしかたを、1日ひとつずつ。無理なく読める分量でお送りします。',
  },
];

const contents = [
  {
    title: '心を整えるメッセージ',
    desc: '今まさに迷っている方、立ち止まっている方へ。岡が日々の中で書きとめた言葉を、そのままお届けします。',
    badge: '不定期',
  },
  {
    title: '神社参拝の優先案内',
    desc: '少人数で開催される神社参拝の最新日程を、サイトより先にLINEでお届けします。',
    badge: '優先告知',
  },
  {
    title: 'パワーストーン（1点もの）のお披露目',
    desc: 'ひとつひとつ表情が異なる1点もののパワーストーン。新しいもののご案内は、いつもLINE公式がいちばん早いです。',
    badge: '先行案内',
  },
  /* 🔴 「月1回『整える会』」は**まだ未確定**のため外しました（2026-08-06 福田さん判断）。
     /mind/ 側からも同時に外しています。開催が決まったら両方に戻すこと。 */
];
---

<Base
  title="LINE公式のご案内"
  description="神社参拝の本質と心の整え方を不定期でお届け。ご登録で「岡の声でご案内する瞑想の導入動画」と「14日間のステップ講座」をお送りしています。"
  surface="dark"
>
  <div class="wrap section stack">
    {/* ── ヒーロー ── */}
    <header class="line-hero" data-reveal>
      <div class="line-hero__info stack">
        <p class="kicker">LINE公式</p>
        <h1 class="mj">
          神社と、心の整え方の話を<br />
          不定期でお届けします。
        </h1>
        {/* 🔴 ここには以前「売るのはLINEです。サイトは『信じてもらう場所』」と書いてありました。
               これは**社内の設計メモ**です。読者に向けて「売る」と宣言していることになるので外しました。
               設計の意図は 20_Site/SITE_CONCEPT.md に書いてあります。ページに戻さないこと。 */}
        <p class="lede">
          神社参拝の日程も、新しいパワーストーンのご案内も、<br />
          LINEがいちばん早くお伝えできます。
        </p>

        <div class="line-hero__action">
          <a href={LINE_URL} class="btn btn--line btn--lg" target="_blank" rel="noopener">
            LINEで友だち追加する
          </a>
          <span class="note">※ 無料です。いつでもワンタップで解除できます。</span>
        </div>
      </div>

      {/* QRコード。★PCでだけ出ます（スマホでは上のCSSで消しています） */}
      <div class="line-hero__qr-box stack">
        <div class="qr" style="--qr-size:200px">
          <img
            src={withBase('/assets/line-qr-green.png')}
            alt="LINE公式 友だち追加 QRコード"
            width="360"
            height="360"
          />
        </div>
        <p class="note text-center">お手元のスマホで<br />読み取れます</p>
      </div>
    </header>

    {/* ── 登録特典 ── */}
    <section class="stack benefits-sec" data-reveal>
      <p class="kicker">ご登録の特典</p>
      <h2>ご登録の方にお送りしているもの</h2>

      <div class="benefits-grid">
        {benefits.map((b) => (
          <div class="benefit-card stack">
            <div class="benefit-card__head">
              {/* 🔴 絵文字アイコンは外しました（2026-08-06）。静かなトーンから浮くためです */}
              <span class="benefit-card__tag">{b.tag}</span>
            </div>
            <h3 class="benefit-card__title mj">{b.title}</h3>
            <p class="benefit-card__desc">{b.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ── LINEで届くこと ── */}
    <section class="stack contents-sec" data-reveal>
      <p class="kicker">お届けしていること</p>
      <h2>LINEでお届けしていること</h2>

      <div class="contents-grid">
        {contents.map((c) => (
          <div class="content-card stack">
            <div class="content-card__head">
              <span class="content-card__badge">{c.badge}</span>
              <h3 class="content-card__title mj">{c.title}</h3>
            </div>
            <p class="content-card__desc">{c.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ── 登録CTA ── */}
    <section class="stack text-center cta-sec" data-reveal>
      <h2 class="mj">あなたとLINEでお会いできることを<br />楽しみにしています。</h2>
      <p class="lede">ご登録のあと、すぐに導入動画と、14日間講座の1日目が届きます。</p>
      <div class="cta-box">
        <a href={LINE_URL} class="btn btn--line btn--lg" target="_blank" rel="noopener">
          LINEで友だち追加する
        </a>
      </div>
      <p class="note">※ 通知が多く感じる場合は、設定からいつでも通知オフ・ブロックが可能です。</p>
    </section>
  </div>
</Base>

<style>
  .line-hero {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 3.5rem;
    align-items: center;
    margin-block: 1rem 2rem;
  }
  @media (max-width: 860px) {
    .line-hero {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 2.5rem;
    }
    /* 🔴 スマホ・タブレットではQRを出しません（2026-08-06 福田さん判断）。
          自分の画面は自分で読み取れないので、場所を取るだけです。
          共通の LineCta.astro も同じ 860px で消しています。**片方だけ直さないこと。** */
    .line-hero__qr-box { display: none; }
  }

  .line-hero__action {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
    margin-top: 1rem;
  }

  .btn--line {
    background: #06c755;
    color: #ffffff;
    font-weight: 600;
    border: none;
    box-shadow: 0 4px 16px rgba(6, 199, 85, 0.35);
  }
  .btn--line:hover {
    background: #05b34c;
    color: #ffffff;
    box-shadow: 0 6px 20px rgba(6, 199, 85, 0.5);
  }

  .btn--lg {
    padding: 1rem 2.25rem;
    font-size: var(--fs-lg);
  }

  .line-hero__qr-box {
    background: var(--bg-2);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--rule);
    align-items: center;
  }


  /* 特典カード */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.5rem;
  }

  .benefit-card {
    background: var(--bg-2);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 8px;
    padding: 2rem;
    position: relative;
  }

  .benefit-card__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .benefit-card__tag {
    font-size: var(--fs-note);
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.06em;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .benefit-card__title {
    font-size: var(--fs-h2);
    color: var(--fg);
    margin: 0;
    line-height: 1.4;
  }

  .benefit-card__desc {
    font-size: var(--fs-sm);
    color: var(--fg-2);
    line-height: 1.75;
    margin: 0;
  }

  /* LINEお届け内容カード */
  .contents-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.25rem;
  }

  .content-card {
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 1.5rem;
  }

  .content-card__head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .content-card__badge {
    font-size: var(--fs-note);
    color: var(--asagi);
    font-weight: 500;
  }

  .content-card__title {
    font-size: var(--fs-xl);
    color: var(--fg);
    margin: 0;
  }

  .content-card__desc {
    font-size: var(--fs-sm);
    color: var(--fg-2);
    line-height: 1.7;
    margin: 0;
  }

  .cta-sec {
    padding-block: 2.5rem 1.5rem;
  }
  .cta-box {
    margin-top: 1.25rem;
    display: flex;
    justify-content: center;
  }

  .text-center {
    text-align: center;
  }
</style>
