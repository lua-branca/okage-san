---
import { withBase } from '../utils/base';

/** LINE登録セクション。サイトの最重要CV（顧客の67%がLINE希望）。
 *
 *  🔴 文言の決めごと（2026-07-31 整理）
 *   ① **配信は「不定期」**。「週に一度」と書かない。
 *      毎週出せる体制がまだないので、書いた時点で守れない約束になります。
 *   ② 特典は **「岡の声でご案内する瞑想の動画」**。
 *      「パワーストーンを使った瞑想」と書かない ── なくても瞑想はできます。
 *      要るように読ませると、無料で始めたい人を取りこぼします。
 *   ③ **「神遊び」を見出し・CTAで使わない。**「神社参拝」に統一。
 *      神遊びは岡さん本人の呼び方で、本文で一度だけ紹介する言葉です
 *      → SITE_SPEC 第4章。「ツアー」は全面禁止。
 *   ④ 表記は「パワーストーン」に統一（2026-08-06・検索を取るため）。
 *      入荷案内は扱いが増える可能性を残して「新しく入ったもの」のままにしています。
 *
 *  ⚠️ ここを直したら /line/ も揃えること。2か所で違うことを言っていました。 */
interface Props {
  /** 'section' = 大きなブロック / 'inline' = 記事末などに置く小さい版 */
  variant?: 'section' | 'inline';
}
const { variant = 'section' } = Astro.props;
const LINE_URL = 'https://lin.ee/XAxux9k';
---

{variant === 'section' ? (
  <section class="line surface-dark">
    <div class="wrap line-grid">
      <div class="stack">
        <p class="kicker">LINE公式</p>
        <h2>
          神社と、心の整え方の話を<br />不定期でお届けします
        </h2>
        <p class="lede">
          ご登録で「岡の声でご案内する瞑想の導入動画」と「14日間のステップ講座」をお送りしています。<br />
          神社参拝の日程も、新しいパワーストーンのご案内も、LINEがいちばん早くお伝えできます。
        </p>
        <div class="line-btns">
          <a href={LINE_URL} class="btn btn--line" target="_blank" rel="noopener">LINEで受け取る</a>
          <a href={withBase('/line/')} class="btn btn--ghost">LINEの特典・詳細</a>
        </div>
        <p class="note">※ 無料です。いつでも解除できます。</p>
      </div>

      <div class="line-qr">
        <div class="qr">
          <img
            src={withBase('/assets/line-qr-green.png')}
            alt="LINE公式 QRコード"
            width="360"
            height="360"
          />
        </div>
        <span class="note">スマホで読み取れます</span>
      </div>
    </div>
  </section>
) : (
  <aside class="line-inline">
    <p class="note">こういう話を、LINEでもお送りしています。</p>
    <div class="line-btns">
      <a href={LINE_URL} class="btn btn--line" target="_blank" rel="noopener">LINEで受け取る</a>
      <a href={withBase('/line/')} class="btn btn--ghost">詳細</a>
    </div>
  </aside>
)}

<style>
  .line { padding-block: var(--gap-section); }
  .line-grid {
    display: grid;
    grid-template-columns: 1fr 180px;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 860px) {
    .line-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .line-qr { display: none; }
  }

  .line-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .btn--line {
    background: #06c755;
    color: #ffffff;
    font-weight: 600;
    border: none;
  }
  .btn--line:hover {
    background: #05b34c;
    color: #ffffff;
  }

  .line-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-2);
    padding: 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--rule);
  }

  .line-inline {
    margin-top: 3rem;
    padding: 1.75rem;
    background: var(--bg-2);
    border-top: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
