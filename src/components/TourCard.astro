---
import { withBase } from '../utils/base';

/** 神遊び（神社ツアー）1件のカード。
 *  ⚠️ 残席は出しません。口コミ中心で、人数は個別連絡で調整しているため
 *     （数字を出すと「埋まっている／空いている」の余計な判断材料になる）。
 *  状態は state で言葉として渡す：受付中 / 満席 / 終了 など。 */
interface Props {
  /** ISO文字列 or Date。'2026-08-09' のように日付だけでOK */
  date: string | Date;
  title: string;
  /** 集合地・エリア。例：「東京・大宮」 */
  place: string;
  price?: number;
  /** 申込先／詳細ページ。**素のパス**を渡してください（例 `/kamiasobi/xxx/`）。
   *  🔴 base の付与はこのコンポーネントの中で行います。
   *     呼び出し側で withBase() すると二重になります（2026-07-30 の不具合）
   *  ⚠️ `https://` で始まる外部URL（LINEなど）を渡した場合は base を付けず、
   *     別タブで開きます。★2026-08-07 追加 */
  href?: string;
  /** ボタンの文言。既定は「この回に申し込む」。
   *  LINEへ送るときは「LINEで申し込む」のように渡してください */
  ctaLabel?: string;
  /** 受付中 / 満席 / 終了。未指定なら出さない */
  state?: string;
  /** 一言（「昼食・移動は各自手配です」など） */
  note?: string;
  /** 終了した回はトーンを落とす */
  past?: boolean;
}
const { date, title, place, price, href, ctaLabel, state, note, past = false } = Astro.props;

// 外部URL（LINE等）は base を付けない。付けると /okage-san/https://... になります
const isExternal = !!href && /^https?:\/\//.test(href);

const d = date instanceof Date ? date : new Date(date);
const y = d.getFullYear();
const m = d.getMonth() + 1;
const day = d.getDate();
const wd = ['日', '月', '火', '水', '木', '金', '土'][d.getDay()];
const iso = d.toISOString().slice(0, 10);

// 朱は「止まっている状態」だけに使う。受付中を朱にすると警告に見える
const openish = state === '受付中' || state === '募集中';
---

<article class={`tour${past ? ' tour--past' : ''}`}>
  <div class="tour__d">
    <time datetime={iso} class="tabnum">
      <span class="tour__ym">{y}.{String(m).padStart(2, '0')}</span>
      <span class="tour__dd mj">{day}</span>
      <span class="tour__wd">（{wd}）</span>
    </time>
  </div>

  <div class="tour__b">
    <h3 class="tour__t">{title}</h3>
    <p class="tour__m note">
      {place}
      {price !== undefined && (
        <>
          <span aria-hidden="true">／</span>
          <span class="tabnum">¥{price.toLocaleString('ja-JP')}</span>
        </>
      )}
    </p>
    {note && <p class="note">{note}</p>}
    {state && <p><span class={`pill${openish ? ' pill--open' : ''}`}>{state}</span></p>}
    {href && (
      <p class="tour__cta">
        <a
          href={isExternal ? href : withBase(href)}
          class={`btn${isExternal ? ' btn--line' : ''}`}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener' : undefined}
        >{ctaLabel ?? 'この回に申し込む'}</a>
      </p>
    )}
  </div>
</article>

<style>
  .tour {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.25rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--rule);
  }

  /* 日付：明朝の数字を大きく。ここが一覧のリズムを作る */
  .tour__d time { display: flex; flex-direction: column; line-height: 1.3; }
  .tour__ym { font-size: var(--fs-label); letter-spacing: .1em; color: var(--accent); }
  .tour__dd { font-size: 2.1rem; color: var(--fg); line-height: 1.2; }
  .tour__wd { font-size: var(--fs-label); color: var(--fg-2); }

  .tour__b { display: flex; flex-direction: column; gap: .5rem; }
  .tour__t { font-size: var(--fs-lg); color: var(--fg); }
  .tour__m { color: var(--fg-2); }
  .tour__cta { margin-top: .35rem; }

  /* LINEボタン。★2026-08-07 追加
     ⚠️ .btn--line は LineCta.astro / line.astro の中で**scoped**に定義されています。
        Astroのscoped CSSは他のコンポーネントに届かないので、ここで同じ色を持っています。
        色を変えるときは3か所とも直してください（LINE緑は先方指定色なので、まず変わりません）。 */
  .btn--line { background: #06c755; color: #fff; font-weight: 600; border: none; }
  .btn--line:hover { background: #05b34c; color: #fff; }

  /* 終了した回：情報としては残すが、目立たせない */
  .tour--past { opacity: .6; }

  @media (max-width: 640px) {
    .tour { grid-template-columns: 1fr; gap: .75rem; }
    .tour__d time { flex-direction: row; align-items: baseline; gap: .4rem; }
    .tour__dd { font-size: 1.5rem; }
  }
</style>
