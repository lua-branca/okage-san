---
import { withBase } from '../utils/base';

/** ヘッダー。全ページ共通。
 *
 *  🔴 画面幅の決めごと（2026-07-31 統一）
 *     スマホ 〜640px ／ タブレット 641〜1079px ／ PC 1080px〜
 *     **1080px でメニューの形が変わります**（PCは横並び／それ未満はハンバーガー）。
 *     ⚠️ 1024pxで切っていたら、その幅では横並びが収まらず折り返していました。
 *
 *  🔴 2026-08-04：混在していた 560/700/720/768px を整理し、**3組だけ**にしました。
 *     使うのは必ずこの中から選んでください（正本はこのコメント）：
 *
 *       スマホ      (max-width: 640px)  /  (min-width: 641px)
 *       タブレット   (max-width: 860px)  /  (min-width: 861px)
 *       PC         (max-width: 1079px) /  (min-width: 1080px)
 *
 *     ★max と min は必ず1pxずらした対で使います（640/641・860/861・1079/1080）。
 *       同じ値を両方に使うと、その1pxで両方のルールが効いて表示が壊れます。
 *
 *  🔴 ハンバーガーは <details> で作っています。**JSを使いません。**
 *     JSが止まってもメニューは開きます（読者の多くは50代以上・スマホ）。
 *
 *  ⚠️ メニューはPC用とスマホ用で2回描画しています。
 *     <details> の中身をCSSでPC表示に戻す書き方はブラウザ差が出るため、
 *     見た目の確実さを優先しました。**リンクの定義（nav）は1か所**なのでズレません。
 *
 *  🔴 ナビは**5つ＋お問い合わせボタンまで**。これ以上増やすとPCで折り返します。
 *     LINEボタンはヘッダーから外しました（2026-07-31 福田判断）。
 *     ブランド名＋メニュー6つ＋LINEボタンが1024pxに収まらず、
 *     「神社参 / 拝」のように語の途中で折り返していたためです。
 *     LINEへの導線は、各ページ末尾の LineCta とフッターにあります。
 *     プライベートプランは意図的に入れていません
 *     （入口を増やすと主役の神社参拝が弱くなるため）→ SITE_SPEC 第4章 */
interface Props { surface?: 'light' | 'dark'; }
const { surface = 'light' } = Astro.props;

const nav = [
  { href: withBase('/kamiasobi/'), label: '神社参拝' },
  { href: withBase('/mind/'), label: '心を整える' },
  { href: withBase('/session/'), label: '個人セッション' },
  { href: withBase('/blog/'), label: '神道のはなし' },
  { href: withBase('/about/'), label: '岡慶行について' },
];
---

<header class="hd">
  <div class="wrap hd__in">
    <a href={withBase('/')} class="brand" aria-label="トップへ">
      <img src={withBase('/assets/logo.png')} alt="" width="52" height="52" />
      <span class="brand__tx">
        <span class="brand__n">マインドフリー神道学アカデミア</span>
        <span class="brand__s">神社は、自分を整える場所</span>
      </span>
    </a>

    {/* PC（1080px〜）：横並び */}
    <nav class="nav nav--pc" aria-label="メインメニュー">
      {nav.map((i) => <a href={i.href}>{i.label}</a>)}
      <a href={withBase('/contact/')} class="nav__cta">お問い合わせ</a>
    </nav>

    {/* スマホ・タブレット（〜1079px）：ハンバーガー */}
    <details class="hb">
      <summary class="hb__btn" aria-label="メニュー">
        <span class="hb__bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="hb__tx">メニュー</span>
      </summary>
      <nav class="hb__panel" aria-label="メインメニュー（スマホ）">
        {nav.map((i) => <a href={i.href}>{i.label}</a>)}
        <a href={withBase('/contact/')} class="nav__cta">お問い合わせ</a>
      </nav>
    </details>
  </div>
</header>

<style>
  /* 🔴 2026-08-04：スクロールしても上に残るようにしました（福田要望）。
        ★固定にできるのは、直前にヘッダーへ地の色（#1B1523）を入れたからです。
          背景が透明のままだと、下を流れる写真や文字がメニューに透けて読めません。
        ⚠️ sticky なので、position: relative は捨てられません（ハンバーガーの
           パネルが .hd を基準に絶対配置されているため）。sticky は relative の
           はたらきも兼ねるので、これで両方成立します。
        ⚠️ z-index: 30 は、ハンバーガーのパネル（20）より上。
           パネルは .hd の**中**にあるので、一緒に持ち上がります。 */
  .hd {
    border-bottom: 1px solid var(--rule);
    padding-block: 1rem;
    position: sticky;
    top: 0;
    z-index: 30;
  }

  /* 🔴 2026-08-04：ヘッダーをフッターと同じ地の色（#1B1523）の帯にしました（福田判断）。
        ★上下が同じ濃さの帯で挟まれ、あいだの本文が浮き上がります。
          トップではヘッダーのすぐ下がFVの写真なので、暗い帯 → 写真の順になり、
          写真が額に入ったように見えます。
        ⚠️ 麻の葉の地紋は**入れていません**。ヘッダーは高さ85pxしかなく、
           柄のタイル（156px）が半分しか入らないため、六角形が閉じないまま切れて
           「斜めの線がザワザワした帯」になります。柄はフッターだけ。
        ⚠️ 明るい面（.surface-light）には効かせません。今は未使用ですが、
           将来ホワイトペーパー等で復活したときに黒帯が出ると事故になるためです。 */
  :global(.surface-dark) .hd {
    background: #1B1523;
    /* 🔴 金の細線。フッター（22%）より濃い45%にしています（2026-08-04 福田判断）。
          ★固定ヘッダーなので、下を写真や本文が流れていきます。
            その境目を作るのがこの線の役目です。
          ⚠️ 固定にする前は「暗い帯 → 暗い写真」で明るさが変わらず、
             22%では線が沈んで見えませんでした。固定にして初めて意味が出た線です。
          ⚠️ フッターの線とは濃さが違います。あちらは色が地続きなので薄くて足ります。
             揃える必要はありません（役目が違うため）。 */
    border-bottom-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .hd__in {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.5rem;
    max-width: 64rem;  /* ヘッダーだけ本文より広く */
  }

  .brand { display: flex; align-items: center; gap: .8rem; border-bottom: 0; flex-shrink: 0; }
  .brand img { width: 52px; height: 52px; }
  .brand__tx { display: flex; flex-direction: column; gap: .15rem; }
  /* 🔴 15px → 18px。52pxのロゴに対して文字が負けていました（2026-07-31） */
  .brand__n {
    font-family: var(--mincho);
    font-size: var(--fs-xl);
    letter-spacing: .04em;
    color: var(--fg);
    line-height: 1.35;
  }
  .brand__s { font-size: var(--fs-label); letter-spacing: .1em; color: var(--accent); line-height: 1.5; }

  .nav { display: flex; align-items: center; gap: 1.25rem; }
  /* 🔴 nowrap 必須。これがないと「神社参 / 拝」のように語の途中で折り返します
        （2026-07-31：PCで実際に起きていました） */
  .nav a, .hb__panel a { font-size: var(--fs-sm); border-bottom: 0; color: var(--fg); white-space: nowrap; }
  .nav a:hover, .hb__panel a:hover { color: var(--link); }
  .nav__cta {
    color: var(--accent) !important;
    border: 1px solid var(--accent) !important;
    padding: .4rem .8rem;
    border-radius: var(--radius);
    font-size: var(--fs-note) !important;
    white-space: nowrap;
  }

  /* ── ハンバーガー ── */
  .hb { flex-shrink: 0; }
  .hb__btn {
    display: flex; align-items: center; gap: .5rem;
    /* 指で押せる大きさを確保する（44px以上） */
    min-height: 44px; padding: .4rem .2rem;
    cursor: pointer; list-style: none;
    color: var(--fg);
  }
  .hb__btn::-webkit-details-marker { display: none; }
  .hb__btn:focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }
  .hb__bars { display: flex; flex-direction: column; gap: 4px; width: 22px; }
  .hb__bars i { display: block; height: 2px; background: currentColor; transition: transform .2s ease, opacity .2s ease; }
  .hb__tx { font-size: var(--fs-label); letter-spacing: .1em; }

  /* 開いたら×印に */
  .hb[open] .hb__bars i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hb[open] .hb__bars i:nth-child(2) { opacity: 0; }
  .hb[open] .hb__bars i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .hb__panel {
    position: absolute;
    left: 0; right: 0; top: 100%;
    z-index: 20;
    display: flex; flex-direction: column; gap: .25rem;
    padding: 1rem 1.5rem 1.5rem;
    background: var(--bg-2);
    border-bottom: 1px solid var(--rule);
    box-shadow: 0 12px 30px rgba(0, 0, 0, .45);
  }
  /* 指で押しやすいよう1行を大きく取る */
  .hb__panel a { padding-block: .7rem; min-height: 44px; display: flex; align-items: center; }
  .hb__panel .nav__cta { justify-content: center; margin-top: .6rem; }

  @media (prefers-reduced-motion: reduce) { .hb__bars i { transition: none; } }

  /* ── PC（1080px〜）：横並びに。ハンバーガーは消す ── */
  @media (min-width: 1080px) {
    .hb { display: none; }
  }
  /* ── 〜1079px：横並びを消してハンバーガーに ── */
  @media (max-width: 1079px) {
    .nav--pc { display: none; }
  }
  /* ── スマホ（〜640px）：ロゴまわりを詰める ── */
  @media (max-width: 640px) {
    .brand img { width: 42px; height: 42px; }
    .brand__n { font-size: var(--fs-body); }
    .hb__tx { display: none; }
  }
</style>
